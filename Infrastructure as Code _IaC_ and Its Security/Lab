nano __main__.py
import pulumi
import pulumi_aws as aws

# Create a VPC
vpc = aws.ec2.Vpc("main-vpc",
    cidr_block="10.0.0.0/16",
    enable_dns_hostnames=True,
    enable_dns_support=True,
    tags={
        "Name": "main-vpc",
        "Environment": "lab"
    }
)

# Create a secure S3 bucket
bucket = aws.s3.Bucket("secure-bucket",
    tags={
        "Name": "SecureBucket",
        "Environment": "lab"
    }
)

# Block all public access
bucket_public_access_block = aws.s3.BucketPublicAccessBlock("bucket-pab",
    bucket=bucket.id,
    block_public_acls=True,
    block_public_policy=True,
    ignore_public_acls=True,
    restrict_public_buckets=True
)

# Enable server-side encryption
bucket_encryption = aws.s3.BucketServerSideEncryptionConfiguration("bucket-encryption",
    bucket=bucket.id,
    rules=[aws.s3.BucketServerSideEncryptionConfigurationRuleArgs(
        apply_server_side_encryption_by_default=aws.s3.BucketServerSideEncryptionConfigurationRuleApplyServerSideEncryptionByDefaultArgs(
            sse_algorithm="AES256"
        )
    )]
)

# Enable versioning
bucket_versioning = aws.s3.BucketVersioning("bucket-versioning",
    bucket=bucket.id,
    versioning_configuration=aws.s3.BucketVersioningVersioningConfigurationArgs(
        status="Enabled"
    )
)

# Export the bucket name and VPC ID
pulumi.export("bucket_name", bucket.bucket)
pulumi.export("vpc_id", vpc.id)
Subtask 3.3: Create Security Policy with OPA
Create a policies directory:
mkdir policies
cd policies
Create an OPA policy for S3 bucket security:
nano s3-security-policy.rego
package pulumi.s3

# Deny S3 buckets that allow public access
deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketPublicAccessBlock:BucketPublicAccessBlock"
    
    # Check if any public access is allowed
    resource.properties.blockPublicAcls == false
    msg := sprintf("S3 bucket public access block must block public ACLs: %s", [resource.name])
}

deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketPublicAccessBlock:BucketPublicAccessBlock"
    
    resource.properties.blockPublicPolicy == false
    msg := sprintf("S3 bucket public access block must block public policies: %s", [resource.name])
}

deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketPublicAccessBlock:BucketPublicAccessBlock"
    
    resource.properties.ignorePublicAcls == false
    msg := sprintf("S3 bucket public access block must ignore public ACLs: %s", [resource.name])
}

deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketPublicAccessBlock:BucketPublicAccessBlock"
    
    resource.properties.restrictPublicBuckets == false
    msg := sprintf("S3 bucket public access block must restrict public buckets: %s", [resource.name])
}

# Require encryption for S3 buckets
deny[msg] {
    bucket := input.resources[_]
    bucket.type == "aws:s3/bucket:Bucket"
    
    # Check if there's no corresponding encryption configuration
    not has_encryption_config(bucket.name)
    msg := sprintf("S3 bucket must have server-side encryption enabled: %s", [bucket.name])
}

has_encryption_config(bucket_name) {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketServerSideEncryptionConfiguration:BucketServerSideEncryptionConfiguration"
    resource.properties.bucket == bucket_name
}

# Require versioning for S3 buckets
deny[msg] {
    bucket := input.resources[_]
    bucket.type == "aws:s3/bucket:Bucket"
    
    not has_versioning_enabled(bucket.name)
    msg := sprintf("S3 bucket must have versioning enabled: %s", [bucket.name])
}

has_versioning_enabled(bucket_name) {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketVersioning:BucketVersioning"
    resource.properties.bucket == bucket_name
    resource.properties.versioningConfiguration.status == "Enabled"
}
Subtask 3.4: Create Policy Validation Script
Go back to the main directory:
cd ..
Create a policy validation script:
nano validate-policy.py
#!/usr/bin/env python3

import json
import subprocess
import sys
import os

def run_opa_eval(policy_path, data_path):
    """Run OPA evaluation on the given policy and data"""
    try:
        cmd = [
            "opa", "eval",
            "-d", policy_path,
            "-i", data_path,
            "data.pulumi.s3.deny"
        ]
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        if result.returncode != 0:
            print(f"Error running OPA: {result.stderr}")
            return None
            
        return json.loads(result.stdout)
    except Exception as e:
        print(f"Error: {e}")
        return None

def main():
    # Generate Pulumi preview to get resource data
    print("Generating Pulumi preview...")
    
    try:
        # Run pulumi preview and capture JSON output
        preview_cmd = ["pulumi", "preview", "--json"]
        preview_result = subprocess.run(preview_cmd, capture_output=True, text=True)
        
        if preview_result.returncode != 0:
            print(f"Error running pulumi preview: {preview_result.stderr}")
            sys.exit(1)
            
        # Parse the preview output to extract resources
        preview_lines = preview_result.stdout.strip().split('\n')
        resources = []
        
        for line in preview_lines:
            try:
                data = json.loads(line)
                if data.get('type') == 'resourcePreEvent':
                    resource_info = {
                        'name': data['metadata']['urn'].split('::')[-1],
                        'type': data['metadata']['type'],
                        'properties': data.get('metadata', {}).get('new', {}).get('inputs', {})
                    }
                    resources.append(resource_info)
            except json.JSONDecodeError:
                continue
        
        # Create input data for OPA
        opa_input = {
            'resources': resources
        }
        
        # Write input data to temporary file
        with open('opa-input.json', 'w') as f:
            json.dump(opa_input, f, indent=2)
        
        print("Running OPA policy evaluation...")
        
        # Run OPA evaluation
        result = run_opa_eval('policies/s3-security-policy.rego', 'opa-input.json')
        
        if result is None:
            sys.exit(1)
            
        # Check for policy violations
        violations = result.get('result', [])
        
        if violations:
            print("\nPolicy violations found:")
            for violation in violations:
                print(f"- {violation}")
            sys.exit(1)
        else:
            print("\nNo policy violations found. Infrastructure is compliant!")
            
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)
    finally:
        # Clean up temporary file
        if os.path.exists('opa-input.json'):
            os.remove('opa-input.json')

if __name__ == "__main__":
    main()
Make the script executable:
chmod +x validate-policy.py
Task 4: Automate Policy Enforcement in CI/CD Pipeline
Subtask 4.1: Create GitHub Actions Workflow
Create the GitHub Actions directory:
mkdir -p .github/workflows
Create a CI/CD workflow file:
nano .github/workflows/iac-security.yml
name: IaC Security Pipeline

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  terraform-security:
    runs-on: ubuntu-latest
    name: Terraform Security Scan
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Terraform
      uses: hashicorp/setup-terraform@v3
      with:
        terraform_version: 1.6.0
        
    - name: Terraform Init
      run: terraform init
      working-directory: ./terraform-security-lab
      
    - name: Terraform Validate
      run: terraform validate
      working-directory: ./terraform-security-lab
      
    - name: Install Checkov
      run: pip3 install checkov
      
    - name: Run Checkov Scan
      run: |
        checkov -f main.tf --output json > checkov-results.json
        checkov -f main.tf --output cli
      working-directory: ./terraform-security-lab
      continue-on-error: true
      
    - name: Upload Checkov Results
      uses: actions/upload-artifact@v3
      with:
        name: checkov-results
        path: ./terraform-security-lab/checkov-results.json

  pulumi-security:
    runs-on: ubuntu-latest
    name: Pulumi Security Validation
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'
        
    - name: Install Pulumi CLI
      uses: pulumi/actions@v4
      
    - name: Install dependencies
      run: pip3 install pulumi pulumi-aws
      working-directory: ./pulumi-security-lab
      
    - name: Install OPA
      run: |
        curl -L -o opa https://openpolicyagent.org/downloads/v0.57.0/opa_linux_amd64_static
        chmod +x opa
        sudo mv opa /usr/local/bin/
        
    - name: Pulumi Preview
      run: pulumi preview --stack dev
      working-directory: ./pulumi-security-lab
      env:
        PULUMI_ACCESS_TOKEN: ${{ secrets.PULUMI_ACCESS_TOKEN }}
        
    - name: Run Policy Validation
      run: python3 validate-policy.py
      working-directory: ./pulumi-security-lab
      env:
        PULUMI_ACCESS_TOKEN: ${{ secrets.PULUMI_ACCESS_TOKEN }}

  security-gate:
    runs-on: ubuntu-latest
    name: Security Gate
    needs: [terraform-security, pulumi-security]
    
    steps:
    - name: Security Gate Check
      run: |
        echo "All security checks completed successfully!"
        echo "Infrastructure is ready for deployment."
