Task 1: Infrastructure as Code with Terraform
Subtask 1.1: Understanding IaC Fundamentals
Infrastructure as Code (IaC) allows you to manage and provision infrastructure through code rather than manual processes. This approach provides:

• Consistency: Same infrastructure every time • Version Control: Track changes and rollback if needed • Automation: Reduce manual errors and deployment time • Security: Implement security policies as code

Subtask 1.2: Create Your First Terraform Template
Let's start by creating a simple AWS infrastructure template.

Create a new directory for your project:
mkdir terraform-security-lab
cd terraform-security-lab
Create the main Terraform configuration file:
nano main.tf
Add the following Terraform configuration:
# Configure the AWS Provider
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  required_version = ">= 1.0"
}

provider "aws" {
  region = "us-east-1"
}

# Create a VPC
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name        = "main-vpc"
    Environment = "lab"
  }
}

# Create an Internet Gateway
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "main-igw"
  }
}

# Create a public subnet
resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true

  tags = {
    Name = "public-subnet"
  }
}

# Create an S3 bucket (intentionally insecure for demonstration)
resource "aws_s3_bucket" "example" {
  bucket = "my-insecure-bucket-${random_string.bucket_suffix.result}"

  tags = {
    Name        = "ExampleBucket"
    Environment = "lab"
  }
}

# Make the S3 bucket public (security issue)
resource "aws_s3_bucket_public_access_block" "example" {
  bucket = aws_s3_bucket.example.id

  block_public_acls       = false
  block_public_policy     = false
  ignore_public_acls      = false
  restrict_public_buckets = false
}

# Random string for unique bucket naming
resource "random_string" "bucket_suffix" {
  length  = 8
  special = false
  upper   = false
}
Create a variables file:
nano variables.tf
variable "environment" {
  description = "Environment name"
  type        = string
  default     = "lab"
}

variable "region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}
Create an outputs file:
nano outputs.tf
output "vpc_id" {
  description = "ID of the VPC"
  value       = aws_vpc.main.id
}

output "bucket_name" {
  description = "Name of the S3 bucket"
  value       = aws_s3_bucket.example.bucket
}
