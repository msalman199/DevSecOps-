Task 5: Advanced Security Configurations
Subtask 5.1: Create Custom Security Policies
Create additional OPA policies:
nano policies/advanced-security.rego
package pulumi.advanced

# Require specific tags on all resources
required_tags := ["Environment", "Owner", "Project"]

deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucket:Bucket"
    
    missing_tags := required_tags[_]
    not resource.properties.tags[missing_tags]
    
    msg := sprintf("Resource %s is missing required tag: %s", [resource.name, missing_tags])
}

# Enforce naming conventions
deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucket:Bucket"
    
    not startswith(resource.name, "secure-")
    msg := sprintf("S3 bucket name must start with 'secure-': %s", [resource.name])
}

# Require MFA delete for S3 buckets in production
deny[msg] {
    resource := input.resources[_]
    resource.type == "aws:s3/bucket:Bucket"
    resource.properties.tags.Environment == "production"
    
    not has_mfa_delete(resource.name)
    msg := sprintf("Production S3 bucket must have MFA delete enabled: %s", [resource.name])
}

has_mfa_delete(bucket_name) {
    resource := input.resources[_]
    resource.type == "aws:s3/bucketVersioning:BucketVersioning"
    resource.properties.bucket == bucket_name
    resource.properties.versioningConfiguration.mfaDelete == "Enabled"
}
Subtask 5.2: Create Security Monitoring Dashboard
Create a monitoring script:
nano security-monitor.py
#!/usr/bin/env python3

import json
import subprocess
import datetime
import os

def generate_security_report():
    """Generate a comprehensive security report"""
    
    report = {
        "timestamp": datetime.datetime.now().isoformat(),
        "terraform_scan": {},
        "pulumi_scan": {},
        "summary": {}
    }
    
    # Run Terraform security scan
    print("Running Terraform security scan...")
    try:
        os.chdir("terraform-security-lab")
        
        # Run Checkov on Terraform files
        result = subprocess.run(
            ["checkov", "-f", "main.tf", "--output", "json"],
            capture_output=True, text=True
        )
        
        if result.stdout:
            terraform_results = json.loads(result.stdout)
            report["terraform_scan"] = {
                "total_checks": len(terraform_results.get("results", {}).get("failed_checks", [])) + 
                               len(terraform_results.get("results", {}).get("passed_checks", [])),
                "failed_checks": len(terraform_results.get("results", {}).get("failed_checks", [])),
                "passed_checks": len(terraform_results.get("results", {}).get("passed_checks", [])),
                "details": terraform_results
            }
        
        os.chdir("..")
        
    except Exception as e:
        print(f"Error scanning Terraform: {e}")
        report["terraform_scan"]["error"] = str(e)
    
    # Run Pulumi security validation
    print("Running Pulumi security validation...")
    try:
        os.chdir("pulumi-security-lab")
        
        # Run policy validation
        result = subprocess.run(
            ["python3", "validate-policy.py"],
            capture_output=True, text=True
        )
        
        report["pulumi_scan"] = {
            "status": "passed" if result.returncode == 0 else "failed",
            "output": result.stdout,
            "errors": result.stderr
        }
        
        os.chdir("..")
        
    except Exception as e:
        print(f"Error validating Pulumi: {e}")
        report["pulumi_scan"]["error"] = str(e)
    
    # Generate summary
    terraform_failed = report["terraform_scan"].get("failed_checks", 0)
    pulumi_status = report["pulumi_scan"].get("status", "unknown")
    
    report["summary"] = {
        "overall_status": "passed" if terraform_failed == 0 and pulumi_status == "passed" else "failed",
        "terraform_issues": terraform_failed,
        "pulumi_compliant": pulumi_status == "passed",
        "recommendations": []
    }
    
    if terraform_failed > 0:
        report["summary"]["recommendations"].append("Fix Terraform security issues identified by Checkov")
    
    if pulumi_status != "passed":
        report["summary"]["recommendations"].append("Address Pulumi policy violations")
    
    return report

def main():
    print("Generating IaC Security Report...")
    
    report = generate_security_report()
    
    # Save report to file
    with open("security-report.json", "w") as f:
        json.dump(report, f, indent=2)
    
    # Print summary
    print("\n" + "="*50)
    print("SECURITY REPORT SUMMARY")
    print("="*50)
    print(f"Timestamp: {report['timestamp']}")
    print(f"Overall Status: {report['summary']['overall_status'].upper()}")
    print(f"Terraform Issues: {report['summary']['terraform_issues']}")
    print(f"Pulumi Compliant: {report['summary']['pulumi_compliant']}")
    
    if report['summary']['recommendations']:
        print("\nRecommendations:")
        for rec in report['summary']['recommendations']:
            print(f"- {rec}")
    
    print(f"\nDetailed report saved to: security-report.json")

if __name__ == "__main__":
    main()
