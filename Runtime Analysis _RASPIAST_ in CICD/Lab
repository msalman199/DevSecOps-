#!/usr/bin/env python3

import subprocess
import sys
import json
import time

def run_zap_baseline(target_url, report_format='json'):
    """Run ZAP baseline scan"""
    
    cmd = [
        'docker', 'run', '--rm',
        '--network', 'devsecops-lab',
        '-v', f'{os.getcwd()}/reports:/zap/wrk/:rw',
        'owasp/zap2docker-stable',
        'zap-baseline.py',
        '-t', target_url,
        '-J', 'zap-report.json',
        '-r', 'zap-report.html'
    ]
    
    print(f"Running ZAP baseline scan on {target_url}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    
    return result.returncode, result.stdout, result.stderr

if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 else "http://dvwa-app"
    exit_code, stdout, stderr = run_zap_baseline(target)
    
    print("STDOUT:", stdout)
    if stderr:
        print("STDERR:", stderr)
    
    sys.exit(exit_code)
