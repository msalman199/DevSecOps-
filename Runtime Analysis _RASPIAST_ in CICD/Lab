# Create security report generator script
cat > ~/devsecops-lab/generate-security-report.py << 'EOF'
#!/usr/bin/env python3

import json
import os
import datetime
from pathlib import Path

def generate_security_report():
    """Generate comprehensive security report"""
    
    report_dir = Path("reports")
    report_data = {
        "scan_date": datetime.datetime.now().isoformat(),
        "iast_results": {},
        "rasp_status": {},
        "summary": {}
    }
    
    # Process ZAP IAST results
    zap_report_file = report_dir / "zap-report.json"
    if zap_report_file.exists():
        with open(zap_report_file, 'r') as f:
            zap_data = json.load(f)
            
        alerts = zap_data.get('site', [{}])[0].get('alerts', [])
        
        # Categorize alerts by risk level
        risk_summary = {'High': [], 'Medium': [], 'Low': [], 'Informational': []}
        
        for alert in alerts:
            risk_level = alert.get('riskdesc', '').split()[0]
            if risk_level in risk_summary:
                risk_summary[risk_level].append({
                    'name': alert.get('name', 'Unknown'),
                    'description': alert.get('desc', 'No description'),
                    'solution': alert.get('solution', 'No solution provided'),
                    'instances': len(alert.get('instances', []))
                })
        
        report_data["iast_results"] = {
            "total_alerts": len(alerts),
            "risk_breakdown": {k: len(v) for k, v in risk_summary.items()},
            "detailed_findings": risk_summary
        }
    
    # Check RASP status
    try:
