Task 5: Creating the DevSecOps Pipeline
Subtask 5.1: Configure Jenkins Pipeline
Set up Jenkins for automated security testing:

# Create Jenkins pipeline directory
mkdir -p ~/devsecops-lab/jenkins

# Create Jenkinsfile for DevSecOps pipeline
cat > ~/devsecops-lab/Jenkinsfile << 'EOF'
pipeline {
    agent any
    
    environment {
        DOCKER_COMPOSE_FILE = 'docker-compose.yml'
        ZAP_REPORT_DIR = 'reports'
        APPLICATION_URL = 'http://localhost:8080'
        RASP_URL = 'http://localhost:8081'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }
        
        stage('Build Application') {
            steps {
                echo 'Building application containers...'
                sh '''
                    docker-compose down || true
                    docker-compose build
                    docker-compose up -d
                    sleep 30
                '''
            }
        }
        
        stage('Static Code Analysis') {
            steps {
                echo 'Running static security analysis...'
                sh '''
                    # Run Bandit for Python security issues
                    find . -name "*.py" -exec bandit {} + || true
                    
                    # Check for known vulnerabilities in dependencies
                    safety check || true
                '''
            }
        }
        
        stage('IAST - Interactive Security Testing') {
            steps {
                echo 'Running IAST with OWASP ZAP...'
                sh '''
                    mkdir -p ${ZAP_REPORT_DIR}
                    
                    # Run ZAP baseline scan
                    python3 zap-config/zap-baseline.py ${APPLICATION_URL} || true
                    
                    # Run comprehensive scan
                    python3 zap-config/zap-full-scan.py ${APPLICATION_URL} || true
                '''
            }
        }
        
        stage('RASP Validation') {
            steps {
                echo 'Validating RASP protection...'
                sh '''
                    # Test RASP is active
                    curl -f ${RASP_URL}/health
                    
                    # Test SQL injection protection
                    curl -X POST "${RASP_URL}/vulnerabilities/sqli/" \
                         -d "id=1' OR '1'='1&Submit=Submit" \
                         -H "Content-Type: application/x-www-form-urlencoded" \
                         --fail || echo "RASP blocked SQL injection (expected)"
                    
                    # Test XSS protection
                    curl -X GET "${RASP_URL}/vulnerabilities/xss_r/?name=<script>alert('xss')</script>" \
                         --fail || echo "RASP blocked XSS (expected)"
                '''
            }
        }
        
        stage('Security Report Analysis') {
            steps {
                echo 'Analyzing security test results...'
                sh '''
                    # Process ZAP reports
                    if [ -f "${ZAP_REPORT_DIR}/zap-report.json" ]; then
                        python3 -c "
import json
import sys

with open('${ZAP_REPORT_DIR}/zap-report.json', 'r') as f:
    data = json.load(f)
    
alerts = data.get('site', [{}])[0].get('alerts', [])
high_risk = [a for a in alerts if a.get('riskdesc', '').startswith('High')]
medium_risk = [a for a in alerts if a.get('riskdesc', '').startswith('Medium')]

print(f'Security Scan Results:')
print(f'Total Alerts: {len(alerts)}')
print(f'High Risk: {len(high_risk)}')
print(f'Medium Risk: {len(medium_risk)}')

# Fail build if high-risk vulnerabilities found
if len(high_risk) > 0:
    print('HIGH RISK VULNERABILITIES DETECTED!')
    for alert in high_risk:
        print(f'- {alert.get(\"name\", \"Unknown\")}: {alert.get(\"desc\", \"No description\")}')
    sys.exit(1)
"
                    fi
                '''
            }
        }
        
        stage('Deploy with RASP') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deploying application with RASP protection...'
                sh '''
                    # Ensure RASP proxy is running
                    docker-compose up -d rasp-proxy
                    
                    # Verify deployment
                    curl -f ${RASP_URL}/health
                    echo "Application deployed with RASP protection active"
                '''
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up...'
            sh '''
                # Archive security reports
                tar -czf security-reports.tar.gz ${ZAP_REPORT_DIR}/ || true
                
                # Clean up containers if needed
                # docker-compose down || true
            '''
            
            // Archive artifacts
            archiveArtifacts artifacts: 'security-reports.tar.gz', allowEmptyArchive: true
            archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true
        }
        
        failure {
            echo 'Pipeline failed! Check security reports for issues.'
        }
        
        success {
            echo 'DevSecOps pipeline completed successfully!'
        }
    }
}
EOF
Subtask 5.2: Create Pipeline Helper Scripts
Create utility scripts for the pipeline:

# Create security validation script
cat > ~/devsecops-lab/validate-security.sh << 'EOF'
#!/bin/bash

# Security validation script for DevSecOps pipeline

set -e

echo "=== DevSecOps Security Validation ==="

# Function to check if service is running
check_service() {
    local url=$1
    local service_name=$2
    
    echo "Checking $service_name at $url..."
    if curl -f -s "$url" > /dev/null; then
        echo "✓ $service_name is running"
        return 0
    else
        echo "✗ $service_name is not accessible"
        return 1
    fi
}

# Function to test RASP protection
test_rasp_protection() {
    local rasp_url=$1
    
    echo "Testing RASP protection..."
    
    # Test SQL injection protection
    echo "Testing SQL injection protection..."
    if curl -s -X POST "$rasp_url/vulnerabilities/sqli/" \
            -d "id=1' OR '1'='1&Submit=Submit" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            | grep -q "403\|blocked\|forbidden"; then
        echo "✓ SQL injection blocked by RASP"
    else
        echo "⚠ SQL injection test inconclusive"
    fi
    
    # Test XSS protection
    echo "Testing XSS protection..."
    if curl -s -X GET "$rasp_url/vulnerabilities/xss_r/?name=<script>alert('xss')</script>" \
            | grep -q "403\|blocked\|forbidden"; then
        echo "✓ XSS blocked by RASP"
    else
        echo "⚠ XSS test inconclusive"
    fi
}

# Function to analyze ZAP reports
analyze_zap_reports() {
    local report_dir=$1
    
    echo "Analyzing ZAP security reports..."
    
    if [ -f "$report_dir/zap-report.json" ]; then
        python3 << 'PYTHON_SCRIPT'
import json
import sys
import os

report_file = sys.argv[1] + "/zap-report.json"
if not os.path.exists(report_file):
    print("No ZAP report found")
    sys.exit(0)

with open(report_file, 'r') as f:
    data = json.load(f)

alerts = data.get('site', [{}])[0].get('alerts', [])
risk_counts = {'High': 0, 'Medium': 0, 'Low': 0, 'Informational': 0}

for alert in alerts:
    risk = alert.get('riskdesc', '').split()[0]
    if risk in risk_counts:
        risk_counts[risk] += 1

print(f"ZAP Scan Results Summary:")
print(f"Total Alerts: {len(alerts)}")
for risk, count in risk_counts.items():
    if count > 0:
        print(f"{risk} Risk: {count}")

# Return non-zero if high-risk issues found
if risk_counts['High'] > 0:
    print("\n⚠ HIGH RISK VULNERABILITIES DETECTED!")
    sys.exit(1)
else:
    print("\n✓ No high-risk vulnerabilities detected")
PYTHON_SCRIPT
    else
        echo "No ZAP report found at $report_dir/zap-report.json"
    fi
}

# Main validation flow
main() {
    local app_url=${1:-"http://localhost:8080"}
    local rasp_url=${2:-"http://localhost:8081"}
    local report_dir=${3:-"reports"}
    
    echo "Starting security validation..."
    echo "Application URL: $app_url"
    echo "RASP URL: $rasp_url"
    echo "Report Directory: $report_dir"
    echo ""
    
    # Check services
    check_service "$app_url" "Application"
    check_service "$rasp_url/health" "RASP Proxy"
    
    # Test RASP protection
    test_rasp_protection "$rasp_url"
    
    # Analyze security reports
    analyze_zap_reports "$report_dir"
    
    echo ""
    echo "=== Security Validation Complete ==="
}

# Run main function with arguments
main "$@"
EOF

