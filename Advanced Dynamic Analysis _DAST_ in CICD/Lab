Task 4: Create GitLab CI/CD Pipeline
Subtask 4.1: Create GitLab CI/CD Configuration
Create the main GitLab CI/CD pipeline file:
cat > .gitlab-ci.yml << 'EOF'
stages:
  - build
  - test
  - sast
  - dast-baseline
  - dast-full
  - report

variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: ""

services:
  - docker:dind

before_script:
  - docker info

build:
  stage: build
  image: docker:latest
  script:
    - cd app
    - docker build -t vulnerable-app:$CI_COMMIT_SHA .
    - docker tag vulnerable-app:$CI_COMMIT_SHA vulnerable-app:latest
  artifacts:
    reports:
      dotenv: build.env

sast-semgrep:
  stage: sast
  image: returntocorp/semgrep:latest
  script:
    - semgrep --config=.semgrep/rules.yml app/ --json --output=semgrep-results.json
    - semgrep --config=.semgrep/rules.yml app/ --sarif --output=semgrep-results.sarif
  artifacts:
    reports:
      sast: semgrep-results.sarif
    paths:
      - semgrep-results.json
      - semgrep-results.sarif
    expire_in: 1 week
  allow_failure: true

dast-zap-baseline:
  stage: dast-baseline
  image: docker:latest
  services:
    - docker:dind
  script:
    - mkdir -p zap-reports
    - docker run -d --name vulnerable-app -p 8080:80 vulnerable-app:latest
    - sleep 30
    - docker run --rm --network host -v $(pwd)/zap-reports:/zap/wrk owasp/zap2docker-stable zap-baseline.py -t http://localhost:8080 -r baseline-report.html -J baseline-report.json || true
    - docker stop vulnerable-app
    - docker rm vulnerable-app
  artifacts:
    paths:
      - zap-reports/baseline-report.html
      - zap-reports/baseline-report.json
    expire_in: 1 week
  allow_failure: true

dast-zap-full:
  stage: dast-full
  image: docker:latest
  services:
    - docker:dind
  script:
    - mkdir -p zap-reports
    - docker run -d --name vulnerable-app -p 8080:80 vulnerable-app:latest
    - sleep 30
    - docker run --rm --network host -v $(pwd)/zap-reports:/zap/wrk owasp/zap2docker-stable zap-full-scan.py -t http://localhost:8080 -r full-report.html -J full-report.json -m 5 || true
    - docker stop vulnerable-app
    - docker rm vulnerable-app
  artifacts:
    paths:
      - zap-reports/full-report.html
      - zap-reports/full-report.json
    expire_in: 1 week
  allow_failure: true
  when: manual

generate-security-report:
  stage: report
  image: python:3.9-slim
  script:
    - pip install jinja2 json2html
    - python generate_report.py
  artifacts:
    paths:
      - security-dashboard.html
    expire_in: 1 week
  dependencies:
    - sast-semgrep
    - dast-zap-baseline
    - dast-zap-full
EOF
Subtask 4.2: Create Report Generation Script
Create a Python script to generate consolidated security reports:
cat > generate_report.py << 'EOF'
#!/usr/bin/env python3
import json
import os
from datetime import datetime
from jinja2 import Template

def load_json_file(filepath):
    """Load JSON file if it exists"""
    if os.path.exists(filepath):
        with open(filepath, 'r') as f:
            return json.load(f)
    return None

def generate_security_dashboard():
    """Generate comprehensive security dashboard"""
    
    # Load scan results
    semgrep_results = load_json_file('semgrep-results.json')
    zap_baseline = load_json_file('zap-reports/baseline-report.json')
    zap_full = load_json_file('zap-reports/full-report.json')
    
    # HTML template
    template_str = """
    <!DOCTYPE html>
    <html>
    <head>
        <title>Security Scan Dashboard</title>
        <style>
            body { font-family: Arial, sans-serif; margin: 20px; }
            .header { background-color: #f4f4f4; padding: 20px; border-radius: 5px; }
            .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
            .critical { background-color: #ffebee; border-left: 5px solid #f44336; }
            .warning { background-color: #fff3e0; border-left: 5px solid #ff9800; }
            .info { background-color: #e3f2fd; border-left: 5px solid #2196f3; }
            .success { background-color: #e8f5e8; border-left: 5px solid #4caf50; }
            table { width: 100%; border-collapse: collapse; margin: 10px 0; }
            th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
            th { background-color: #f2f2f2; }
        </style>
    </head>
    <body>
        <div class="header">
            <h1>Security Scan Dashboard</h1>
            <p>Generated on: {{ timestamp }}</p>
        </div>
        
        <div class="section">
            <h2>Scan Summary</h2>
            <table>
                <tr>
                    <th>Scan Type</th>
                    <th>Status</th>
                    <th>Issues Found</th>
                    <th>Severity</th>
                </tr>
                {% if semgrep_summary %}
                <tr>
                    <td>SAST (Semgrep)</td>
                    <td>{{ semgrep_summary.status }}</td>
                    <td>{{ semgrep_summary.total_issues }}</td>
                    <td>{{ semgrep_summary.max_severity }}</td>
                </tr>
                {% endif %}
                {% if zap_baseline_summary %}
                <tr>
                    <td>DAST Baseline (ZAP)</td>
                    <td>{{ zap_baseline_summary.status }}</td>
                    <td>{{ zap_baseline_summary.total_issues }}</td>
                    <td>{{ zap_baseline_summary.max_severity }}</td>
                </tr>
                {% endif %}
                {% if zap_full_summary %}
                <tr>
                    <td>DAST Full (ZAP)</td>
                    <td>{{ zap_full_summary.status }}</td>
                    <td>{{ zap_full_summary.total_issues }}</td>
                    <td>{{ zap_full_summary.max_severity }}</td>
                </tr>
                {% endif %}
            </table>
        </div>
        
        {% if semgrep_issues %}
        <div class="section critical">
            <h2>Static Analysis Issues (Semgrep)</h2>
            <table>
                <tr>
                    <th>Rule ID</th>
                    <th>Message</th>
                    <th>File</th>
                    <th>Line</th>
                    <th>Severity</th>
                </tr>
                {% for issue in semgrep_issues %}
                <tr>
                    <td>{{ issue.check_id }}</td>
                    <td>{{ issue.message }}</td>
                    <td>{{ issue.path }}</td>
                    <td>{{ issue.start.line }}</td>
                    <td>{{ issue.extra.severity }}</td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% endif %}
        
        {% if zap_alerts %}
        <div class="section warning">
            <h2>Dynamic Analysis Issues (ZAP)</h2>
            <table>
                <tr>
                    <th>Alert</th>
                    <th>Risk</th>
                    <th>Confidence</th>
                    <th>URL</th>
                    <th>Description</th>
                </tr>
                {% for alert in zap_alerts %}
                <tr>
                    <td>{{ alert.name }}</td>
                    <td>{{ alert.riskdesc }}</td>
                    <td>{{ alert.confidence }}</td>
                    <td>{{ alert.url }}</td>
                    <td>{{ alert.desc[:100] }}...</td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% endif %}
        
        <div class="section info">
            <h2>Recommendations</h2>
            <ul>
                <li>Review and fix all critical and high severity issues</li>
                <li>Implement input validation and sanitization</li>
                <li>Use parameterized queries to prevent SQL injection</li>
                <li>Implement proper output encoding to prevent XSS</li>
                <li>Regular security testing in CI/CD pipeline</li>
            </ul>
        </div>
    </body>
    </html>
    """
    
    # Process data
    context = {
        'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
        'semgrep_issues': [],
        'zap_alerts': [],
        'semgrep_summary': None,
        'zap_baseline_summary': None,
        'zap_full_summary': None
    }
    
    # Process Semgrep results
    if semgrep_results and 'results' in semgrep_results:
        context['semgrep_issues'] = semgrep_results['results']
        context['semgrep_summary'] = {
            'status': 'Completed',
            'total_issues': len(semgrep_results['results']),
            'max_severity': 'ERROR' if any(r['extra']['severity'] == 'ERROR' for r in semgrep_results['results']) else 'WARNING'
        }
    
    # Process ZAP baseline results
    if zap_baseline and 'site' in zap_baseline:
        alerts = []
        for site in zap_baseline['site']:
            if 'alerts' in site:
                alerts.extend(site['alerts'])
        context['zap_alerts'] = alerts
        context['zap_baseline_summary'] = {
            'status': 'Completed',
            'total_issues': len(alerts),
            'max_severity': 'High' if any(alert['riskcode'] == '3' for alert in alerts) else 'Medium'
        }
    
    # Process ZAP full results
    if zap_full and 'site' in zap_full:
        alerts = []
        for site in zap_full['site']:
            if 'alerts' in site:
                alerts.extend(site['alerts'])
        if not context['zap_alerts']:  # Use full scan if baseline not available
            context['zap_alerts'] = alerts
        context['zap_full_summary'] = {
            'status': 'Completed',
            'total_issues': len(alerts),
            'max_severity': 'High' if any(alert['riskcode'] == '3' for alert in alerts) else 'Medium'
        }
    
    # Generate HTML report
    template = Template(template_str)
    html_content = template.render(**context)
    
    with open('security-dashboard.html', 'w') as f:
        f.write(html_content)
    
    print("Security dashboard generated: security-dashboard.html")

if __name__ == "__main__":
    generate_security_dashboard()
EOF
