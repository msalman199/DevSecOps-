Create the security gate script:
cat > security_gate.py << 'EOF'
#!/usr/bin/env python3
import json
import sys
import os

def check_security_gate():
    """Check if security findings exceed acceptable thresholds"""
    
    # Define thresholds
    MAX_CRITICAL_ISSUES = 0
    MAX_HIGH_ISSUES = 2
    MAX_MEDIUM_ISSUES = 5
    
    total_critical = 0
    total_high = 0
    total_medium = 0
    
    # Check Semgrep results
    if os.path.exists('semgrep-results.json'):
        with open('semgrep-results.json', 'r') as f:
            semgrep_data = json.load(f)
            for result in semgrep_data.get('results', []):
                severity = result.get('extra', {}).get('severity', '').upper()
                if severity == 'ERROR':
                    total_critical += 1
                elif severity == 'WARNING':
                    total_medium += 1
    
    # Check ZAP results
    if os.path.exists('zap-reports/baseline-report.json'):
        with open('zap-reports/baseline-report.json', 'r') as f:
            zap_data = json.load(f)
            for site in zap_data.get('site', []):
                for alert in site.get('alerts', []):
                    risk_code = alert.get('riskcode', '0')
                    if risk_code == '3':  # High
                        total_high += 1
                    elif risk_code == '2':  # Medium
                        total_medium += 1
                    elif risk_code == '1':  # Low
                        pass  # Not blocking
    
    # Print summary
    print(f"Security Gate Summary:")
    print(f"Critical Issues: {total_critical} (Max: {MAX_CRITICAL_ISSUES})")
    print(f"High Issues: {total_high} (Max: {MAX_HIGH_ISSUES})")
    print(f"Medium Issues: {total_medium} (Max: {MAX_MEDIUM_ISSUES})")
    
    # Check thresholds
    if total_critical > MAX_CRITICAL_ISSUES:
        print(f"❌ FAILED: Critical issues ({total_critical}) exceed threshold ({MAX_CRITICAL_ISSUES})")
        sys.exit(1)
    
    if total_high > MAX_HIGH_ISSUES:
        print(f"❌ FAILED: High issues ({total_high}) exceed threshold ({MAX_HIGH_ISSUES})")
        sys.exit(1)
    
    if total_medium > MAX_MEDIUM_ISSUES:
        print(f"❌ FAILED: Medium issues ({total_medium}) exceed threshold ({MAX_MEDIUM_ISSUES})")
        sys.exit(1)
    
    print("✅ PASSED: Security gate requirements met")
    return True

if __name__ == "__main__":
    check_security_gate()
EOF
