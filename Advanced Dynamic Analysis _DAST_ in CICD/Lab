#!/usr/bin/env python3
import json
import os
import requests

def send_notification():
    """Send notification about security scan results"""
    
    # Webhook URL (replace with your actual webhook)
    webhook_url = os.environ.get('SECURITY_WEBHOOK_URL', '')
    
    if not webhook_url:
        print("No webhook URL configured")
        return
    
    # Collect scan results
    message = "🔒 Security Scan Results\n\n"
    
    # Add Semgrep results
    if os.path.exists('semgrep-results.json'):
        with open('semgrep-results.json', 'r') as f:
            semgrep_data = json.load(f)
            issue_count = len(semgrep_data.get('results', []))
            message += f"📊 SAST (Semgrep): {issue_count} issues found\n"
    
    # Add ZAP results
    if os.path.exists('zap-reports/baseline-report.json'):
        with open('zap-reports/baseline-report.json', 'r') as f:
            zap_data = json.load(f)
            alert_count = sum(len(site.get('alerts', [])) for site in zap_data.get('site', []))
            message += f"🕷️ DAST (ZAP): {alert_count} alerts found\n"
    
    message += f"\n📋 View detailed report: {os.environ.get('CI_PIPELINE_URL', 'N/A')}"
    
    # Send notification (example for Slack webhook)
    payload = {
        "text": message,
        "username": "Security Scanner",
        "icon_emoji": ":shield:"
    }
    
    try:
        response = requests.post(webhook_url, json=payload)
        if response.status_code == 200:
            print("Notification sent successfully")
        else:
            print(f"Failed to send notification: {response.status_code}")
    except Exception as e:
        print(f"Error sending notification: {e}")

if __name__ == "__main__":
    send_notification()
EOF
